PORT=3000
NODE_ENV=production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-local-password
# Optional Google OAuth (add this redirect URI to the Google Cloud OAuth client)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GEMINI_API_KEY=your-server-side-gemini-key
WEATHER_API_KEY=your-server-side-weatherapi-key
CLAUDE_API_KEY=your-server-side-claude-key
PIXABAY_API_KEY=your-server-side-pixabay-key
